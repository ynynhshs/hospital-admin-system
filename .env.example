# PORT: Express Server Port (AI Studio uses port 3000)
PORT=3000

# NODE_ENV: development | production
NODE_ENV=development

# JWT_SECRET: Secret key for signing and verifying JSON Web Tokens
JWT_SECRET="super_secure_hospital_jwt_secret_2026_xyz"

# MONGODB_URI: MongoDB Atlas connection string (or local mongod)
# Example: mongodb+srv://admin_user:<password>@cluster0.mongodb.net/hospital_admin_db?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.mongodb.net/hospital_admin_db?retryWrites=true&w=majority"

# GEMINI_API_KEY: Optional Gemini API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

